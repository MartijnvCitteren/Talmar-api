<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings that are excluded on purpose. This file is a guardrail: every entry needs a reason, and
     changes are flagged by guardrail-diff. Prefer fixing a finding over excluding it. -->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Generated code: OpenAPI contract models and API interfaces, MapStruct mapper implementations. -->
  <Match>
    <Package name="~eu\.talmar\.api\.vacancy\.adapter\.in\..*"/>
  </Match>
  <Match>
    <Class name="~.*MapperImpl"/>
  </Match>
</FindBugsFilter>
